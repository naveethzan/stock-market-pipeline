{
  "name": "silver-s3-sink-connector",
  "config": {
    "connector.class": "io.confluent.connect.s3.S3SinkConnector",
    "tasks.max": "3",
    "topics": "processed-stock-prices,processed-trading-volume,processed-technical-indicators",
    "s3.region": "${env:AWS_DEFAULT_REGION}",
    "s3.bucket.name": "${env:S3_BUCKET_NAME}",
    "s3.part.size": "10485760",
    "flush.size": "2000",
    "rotate.interval.ms": "300000",
    "rotate.schedule.interval.ms": "900000",
    "timezone": "UTC",
    "locale": "en-US",
    "partitioner.class": "io.confluent.connect.storage.partitioner.FieldPartitioner",
    "partition.field.name": "symbol,date",
    "schema.generator.class": "io.confluent.connect.storage.hive.schema.DefaultSchemaGenerator",
    "storage.class": "io.confluent.connect.s3.storage.S3Storage",
    "format.class": "io.confluent.connect.s3.format.parquet.ParquetFormat",
    "parquet.codec": "snappy",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "io.confluent.connect.avro.AvroConverter",
    "value.converter.schema.registry.url": "http://schema-registry:8081",
    "value.converter.schemas.enable": "true",
    "s3.object.tagging": "true",
    "s3.ssea.name": "AES256",
    "store.kafka.keys": "false",
    "store.kafka.headers": "false",
    "s3.compression.type": "none",
    "topics.dir": "silver/stock-data",
    "directory.delim": "/",
    "file.delim": "-",
    "errors.tolerance": "all",
    "errors.deadletterqueue.topic.name": "silver-dlq",
    "errors.deadletterqueue.topic.replication.factor": "1",
    "errors.deadletterqueue.context.headers.enable": "true",
    "errors.log.enable": "true",
    "errors.log.include.messages": "true",
    "transforms": "AddMetadata,ExtractField",
    "transforms.AddMetadata.type": "org.apache.kafka.connect.transforms.InsertField$Value",
    "transforms.AddMetadata.static.field": "ingestion_layer",
    "transforms.AddMetadata.static.value": "silver",
    "transforms.ExtractField.type": "org.apache.kafka.connect.transforms.ExtractField$Value",
    "transforms.ExtractField.field": "data",
    "behavior.on.null.values": "ignore",
    "null.value.behavior": "ignore",
    "schema.compatibility": "BACKWARD_TRANSITIVE"
  }
}