{
  "name": "redshift-streaming-sink",
  "config": {
    "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
    "tasks.max": "3",
    "topics": "processed-stock-prices,processed-trading-volume,processed-technical-indicators",
        "connection.url": "jdbc:redshift://${REDSHIFT_ENDPOINT}:${REDSHIFT_PORT}/${REDSHIFT_DATABASE}?ssl=true&sslfactory=com.amazon.redshift.ssl.NonValidatingFactory",
        "connection.user": "${REDSHIFT_USER}",
        "connection.password": "${REDSHIFT_PASSWORD}",
    "auto.create": "false",
    "auto.evolve": "false",
    "insert.mode": "insert",
    "batch.size": "100",
    "max.retries": "3",
    "retry.backoff.ms": "3000",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "pk.mode": "none",
    "table.types": "TABLE",
    "topics.to.tables": "processed-stock-prices:streaming.processed_stock_stream,processed-trading-volume:streaming.aggregated_data_stream,processed-technical-indicators:streaming.technical_indicators_stream",
    "transforms": "WrapInKafkaRecord,AddTimestamp",
    "transforms.WrapInKafkaRecord.type": "org.apache.kafka.connect.transforms.HoistField$Value",
    "transforms.WrapInKafkaRecord.field": "kafka_value",
    "transforms.AddTimestamp.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
    "transforms.AddTimestamp.target.type": "Timestamp",
    "transforms.AddTimestamp.field": "kafka_timestamp",
    "errors.tolerance": "all",
    "errors.deadletterqueue.topic.name": "redshift-streaming-dlq",
    "errors.deadletterqueue.topic.replication.factor": "1",
    "errors.deadletterqueue.context.headers.enable": "true",
    "errors.log.enable": "true",
    "errors.log.include.messages": "true"
  }
}
