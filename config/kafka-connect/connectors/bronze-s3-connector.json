{
  "name": "bronze-s3-sink-connector",
  "config": {
    "connector.class": "io.confluent.connect.s3.S3SinkConnector",
    "tasks.max": "3",
    "topics": "stock-quotes-realtime,stock-intraday-data",
    "s3.region": "${env:AWS_DEFAULT_REGION}",
    "s3.bucket.name": "${env:S3_BUCKET_NAME}",
    "s3.part.size": "5242880",
    "flush.size": "1000",
    "rotate.interval.ms": "60000",
    "rotate.schedule.interval.ms": "300000",
    "timezone": "UTC",
    "locale": "en-US",
    "partitioner.class": "io.confluent.connect.storage.partitioner.TimeBasedPartitioner",
    "partition.duration.ms": "3600000",
    "path.format": "year=YYYY/month=MM/day=dd/hour=HH",
    "timestamp.extractor": "Record",
    "timestamp.field": "timestamp",
    "schema.generator.class": "io.confluent.connect.storage.hive.schema.DefaultSchemaGenerator",
    "storage.class": "io.confluent.connect.s3.storage.S3Storage",
    "format.class": "io.confluent.connect.s3.format.avro.AvroFormat",
    "schema.compatibility": "BACKWARD",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "io.confluent.connect.avro.AvroConverter",
    "value.converter.schema.registry.url": "http://schema-registry:8081",
    "value.converter.schemas.enable": "true",
    "s3.object.tagging": "true",
    "s3.ssea.name": "AES256",
    "store.kafka.keys": "false",
    "store.kafka.headers": "false",
    "s3.compression.type": "gzip",
    "topics.dir": "bronze/stock-data",
    "directory.delim": "/",
    "file.delim": "-",
    "errors.tolerance": "all",
    "errors.deadletterqueue.topic.name": "bronze-dlq",
    "errors.deadletterqueue.topic.replication.factor": "1",
    "errors.deadletterqueue.context.headers.enable": "true",
    "errors.log.enable": "true",
    "errors.log.include.messages": "true",
    "transforms": "AddMetadata,TimestampRouter",
    "transforms.AddMetadata.type": "org.apache.kafka.connect.transforms.InsertField$Value",
    "transforms.AddMetadata.static.field": "ingestion_layer",
    "transforms.AddMetadata.static.value": "bronze",
    "transforms.TimestampRouter.type": "org.apache.kafka.connect.transforms.TimestampRouter",
    "transforms.TimestampRouter.topic.format": "${topic}",
    "transforms.TimestampRouter.timestamp.format": "yyyy-MM-dd-HH"
  }
}