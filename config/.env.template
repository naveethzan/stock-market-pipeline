# ===============================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ===============================================
# Copy this file to config/.env and fill in your actual values
# 
###########################################
# Streaming Pipeline Environment Configuration
###########################################

# ======================
# Kafka Configuration
# ======================
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_STREAM_TOPIC=stock-data-stream
KAFKA_STOCK_QUOTES_TOPIC=stock-quotes-realtime
KAFKA_STOCK_INTRADAY_TOPIC=stock-intraday-data
KAFKA_MARKET_EVENTS_TOPIC=market-events
KAFKA_PRODUCER_TIMEOUT=30
KAFKA_CONSUMER_TIMEOUT=30

# ======================
# AWS Configuration
# ======================
# Note: For production, use IAM roles instead of access keys
AWS_REGION=us-east-1
S3_BUCKET_NAME=your_s3_bucket_name_here
AWS_S3_BUCKET=your_s3_bucket_name_here

# AWS Credentials (for local development only)
# In production, use IAM roles or AWS secrets manager
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# ======================
# Spark Streaming Configuration
# ======================
SPARK_MASTER=spark://spark-master:7077
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=2g
SPARK_EXECUTOR_CORES=1
SPARK_DEFAULT_PARALLELISM=4
SPARK_SQL_SHUFFLE_PARTITIONS=8
SPARK_CHECKPOINT_LOCATION=/app/checkpoints
SPARK_TRIGGER_PROCESSING_TIME="10 seconds"
SPARK_WATERMARK_DELAY="1 minute"

# ======================
# External APIs
# ======================
# Alpha Vantage API (for real-time streaming data)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
ALPHA_VANTAGE_RATE_LIMIT=5
ALPHA_VANTAGE_TIMEOUT=30

# Stock Symbols to Track (comma-separated)
STOCK_SYMBOLS=AAPL,GOOGL,MSFT,AMZN,TSLA,META,NVDA,NFLX,AMD,INTC

# ======================
# Redshift Serverless Configuration
# ======================
REDSHIFT_ENDPOINT=your_redshift_endpoint_here
REDSHIFT_DATABASE=your_redshift_database_here
REDSHIFT_PORT=5439
REDSHIFT_USER=your_redshift_username_here
REDSHIFT_PASSWORD=your_redshift_password_here
REDSHIFT_IAM_ROLE=arn:aws:iam::account:role/RedshiftStreamingRole

# ======================
# Schema Registry Configuration
# ======================
SCHEMA_REGISTRY_URL=http://schema-registry:8081
USE_AVRO_SERIALIZATION=true

# ======================
# Streaming Pipeline Configuration
# ======================
PRODUCTION_INTERVAL_SECONDS=60
OUTPUT_BASE_PATH=/app/data/output

# ======================
# Monitoring Configuration
# ======================
LOG_LEVEL=INFO
METRICS_ENABLED=true
HEALTH_CHECK_PORT=8080
DEBUG=false

# Optional: S3 Endpoint URL (for local testing with MinIO)
# S3_ENDPOINT_URL=http://localhost:9000
