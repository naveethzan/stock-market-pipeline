# Streaming Pipeline Configuration Template
# Copy this file to .env and fill in your actual values

# Alpha Vantage API Configuration
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
ALPHA_VANTAGE_RATE_LIMIT=5
ALPHA_VANTAGE_TIMEOUT=30
ALPHA_VANTAGE_RETRY_ATTEMPTS=3
ALPHA_VANTAGE_BACKOFF_FACTOR=2.0

# Stock Symbols to Track (comma-separated)
STOCK_SYMBOLS=AAPL,GOOGL,MSFT,AMZN,TSLA,NVDA,META,NFLX,CRM,ORCL

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=your_username
# KAFKA_SASL_PASSWORD=your_password
# KAFKA_SSL_CA_LOCATION=/path/to/ca-cert
# KAFKA_SSL_CERTIFICATE_LOCATION=/path/to/client-cert
# KAFKA_SSL_KEY_LOCATION=/path/to/client-key

# Kafka Producer Settings
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_RETRIES=3
KAFKA_PRODUCER_BATCH_SIZE=16384
KAFKA_PRODUCER_LINGER_MS=10
KAFKA_PRODUCER_COMPRESSION=snappy

# Kafka Consumer Settings
KAFKA_CONSUMER_GROUP_ID=streaming-pipeline
KAFKA_CONSUMER_AUTO_OFFSET_RESET=latest
KAFKA_CONSUMER_AUTO_COMMIT=false
KAFKA_CONSUMER_MAX_POLL_RECORDS=500

# Kafka Topics
KAFKA_STOCK_QUOTES_TOPIC=stock-quotes-realtime
KAFKA_STOCK_INTRADAY_TOPIC=stock-intraday-data
KAFKA_MARKET_EVENTS_TOPIC=market-events

# Snowflake Configuration
SNOWFLAKE_ACCOUNT=your_account.region
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=STOCK_WH
SNOWFLAKE_DATABASE=STOCK_MARKET
SNOWFLAKE_SCHEMA=STREAMING
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_CONNECTION_TIMEOUT=60
SNOWFLAKE_NETWORK_TIMEOUT=60
SNOWFLAKE_LOGIN_TIMEOUT=60

# AWS S3 Configuration for Snowpipe
S3_BUCKET_NAME=your-s3-bucket-name
S3_PREFIX=streaming-pipeline
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/snowflake-s3-role

# AWS SNS for Snowpipe notifications (optional)
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:snowpipe-notifications
AWS_EXTERNAL_ID=your_external_id

# Spark Configuration
SPARK_APP_NAME=streaming-pipeline
SPARK_MASTER=local[*]
SPARK_CHECKPOINT_LOCATION=/tmp/spark-checkpoints
SPARK_TRIGGER_PROCESSING_TIME=10 seconds
SPARK_WATERMARK_DELAY=1 minute
SPARK_SQL_ADAPTIVE_ENABLED=true
SPARK_SQL_ADAPTIVE_COALESCE=true
SPARK_SERIALIZER=org.apache.spark.serializer.KryoSerializer
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_EXECUTOR_CORES=2
SPARK_MAX_RESULT_SIZE=1g

# Monitoring Configuration
LOG_LEVEL=INFO
METRICS_ENABLED=true
HEALTH_CHECK_PORT=8080
ERROR_RATE_THRESHOLD=0.05
LATENCY_THRESHOLD_MS=5000
THROUGHPUT_THRESHOLD_PER_SEC=100

# Development/Testing Configuration
STREAMING_CONFIG_FILE=config/streaming_pipeline.yaml