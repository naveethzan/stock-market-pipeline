# Alpha Vantage Mock Mode Configuration
# Set this to enable mock API responses for continuous streaming without rate limits

# Enable mock mode (set to 'true' to use mock responses instead of real API)
ALPHA_VANTAGE_MOCK_MODE=true

# Mock API key (not used when mock mode is enabled, but required for configuration)
ALPHA_VANTAGE_API_KEY=mock_api_key_for_development

# Production interval for continuous streaming (in seconds)
# Reduced from default 60 seconds for faster testing with mock data
PRODUCTION_INTERVAL_SECONDS=10

# Stock symbols to track (add more as needed)
STOCK_SYMBOLS=AAPL,GOOGL,MSFT,AMZN,TSLA,META,NVDA,NFLX,AMD,INTC

# Kafka configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_STOCK_QUOTES_TOPIC=stock-quotes-realtime
KAFKA_STOCK_INTRADAY_TOPIC=stock-intraday-data

# Schema Registry
SCHEMA_REGISTRY_URL=http://localhost:8085

# AWS Configuration (will be set in docker-compose for development)
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=stock-market-pipeline-zan

# Logging level
LOG_LEVEL=DEBUG

# Health check port
HEALTH_CHECK_PORT=8080

# Note: When mock mode is enabled:
# - No real API calls are made to Alpha Vantage
# - Realistic stock market data is generated locally
# - No rate limiting issues
# - Continuous streaming can run indefinitely
# - Perfect for development, testing, and demonstrations