# ===============================================
# OPTIMIZED DOCKERFILE FOR STREAMING PRODUCER
# ===============================================
FROM python:3.9-slim as base

# Install system dependencies in single layer with cache optimization
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libffi-dev \
    libssl-dev \
    make \
    curl \
    librdkafka-dev \
    librdkafka1 \
    pkg-config \
    build-essential \
    python3-dev \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Upgrade pip in separate layer for better caching
RUN pip install --upgrade pip --no-cache-dir

# Set working directory
WORKDIR /app

# Copy and install requirements FIRST (best caching strategy)
# This layer only rebuilds when requirements change
COPY requirements-streaming.txt .
RUN pip install --no-cache-dir -r requirements-streaming.txt

# Create non-root user early
RUN useradd --create-home --shell /bin/bash streaming

# Create necessary directories with proper permissions
RUN mkdir -p /app/checkpoints /app/logs && \
    chown -R streaming:streaming /app/checkpoints /app/logs

# Copy application code (this layer rebuilds on code changes)
COPY --chown=streaming:streaming src/ src/
COPY --chown=streaming:streaming config/ config/

# Switch to non-root user
USER streaming

# Set environment variables
ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1

# Simple health check - just check if process is running
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD pgrep -f "alpha_vantage_app" || exit 1

# Default command
CMD ["python", "-m", "streaming_pipeline.producers.alpha_vantage_app"]
