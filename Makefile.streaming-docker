# Makefile for Streaming Pipeline Docker Management
# Provides convenient commands for building, running, and managing Docker containers

.PHONY: help build build-producer build-processor up down logs clean restart health status

# Default target
help:
	@echo "Streaming Pipeline Docker Management"
	@echo "===================================="
	@echo ""
	@echo "Available commands:"
	@echo "  build           - Build all streaming containers"
	@echo "  build-producer  - Build only the producer container"
	@echo "  build-processor - Build only the processor container"
	@echo "  up              - Start all streaming services"
	@echo "  up-producer     - Start only producer service"
	@echo "  up-processor    - Start only processor service"
	@echo "  down            - Stop all streaming services"
	@echo "  restart         - Restart all streaming services"
	@echo "  logs            - Show logs for all streaming services"
	@echo "  logs-producer   - Show logs for producer service"
	@echo "  logs-processor  - Show logs for processor service"
	@echo "  health          - Check health of all streaming services"
	@echo "  status          - Show status of all streaming services"
	@echo "  clean           - Clean up containers and volumes"
	@echo "  shell-producer  - Open shell in producer container"
	@echo "  shell-processor - Open shell in processor container"

# Build targets
build: build-producer build-processor

build-producer:
	@echo "Building streaming producer container..."
	docker build -f Dockerfile.streaming-producer -t streaming-producer:latest .

build-processor:
	@echo "Building streaming processor container..."
	docker build -f Dockerfile.streaming-processor -t streaming-processor:latest .

# Service management
up:
	@echo "Starting streaming pipeline services..."
	docker-compose -f docker-compose.yaml -f docker-compose.streaming.yaml up -d streaming-producer streaming-processor

up-producer:
	@echo "Starting producer service..."
	docker-compose -f docker-compose.yaml -f docker-compose.streaming.yaml up -d streaming-producer

up-processor:
	@echo "Starting processor service..."
	docker-compose -f docker-compose.yaml -f docker-compose.streaming.yaml up -d streaming-processor

down:
	@echo "Stopping streaming pipeline services..."
	docker-compose -f docker-compose.yaml -f docker-compose.streaming.yaml down

restart: down up

# Logging
logs:
	@echo "Showing logs for all streaming services..."
	docker-compose -f docker-compose.yaml -f docker-compose.streaming.yaml logs -f streaming-producer streaming-processor

logs-producer:
	@echo "Showing logs for producer service..."
	docker-compose -f docker-compose.yaml -f docker-compose.streaming.yaml logs -f streaming-producer

logs-processor:
	@echo "Showing logs for processor service..."
	docker-compose -f docker-compose.yaml -f docker-compose.streaming.yaml logs -f streaming-processor

# Health and status
health:
	@echo "Checking health of streaming services..."
	@echo "Producer health:"
	@curl -s http://localhost:8081/health | jq '.' || echo "Producer not responding"
	@echo ""
	@echo "Processor health:"
	@curl -s http://localhost:8082/health | jq '.' || echo "Processor not responding"

status:
	@echo "Streaming services status:"
	@docker-compose -f docker-compose.yaml -f docker-compose.streaming.yaml ps streaming-producer streaming-processor

# Development and debugging
shell-producer:
	@echo "Opening shell in producer container..."
	docker-compose -f docker-compose.yaml -f docker-compose.streaming.yaml exec streaming-producer /bin/bash

shell-processor:
	@echo "Opening shell in processor container..."
	docker-compose -f docker-compose.yaml -f docker-compose.streaming.yaml exec streaming-processor /bin/bash

# Cleanup
clean:
	@echo "Cleaning up streaming containers and volumes..."
	docker-compose -f docker-compose.yaml -f docker-compose.streaming.yaml down -v
	docker system prune -f
	docker volume prune -f

# Development helpers
dev-setup:
	@echo "Setting up development environment..."
	@if [ ! -f config/.env ]; then \
		echo "Creating .env file from template..."; \
		cp config/.env.streaming.template config/.env; \
		echo "Please edit config/.env with your actual configuration values"; \
	fi
	@mkdir -p logs data checkpoints

# Testing
test-producer:
	@echo "Testing producer health endpoint..."
	curl -s http://localhost:8081/health | jq '.'

test-processor:
	@echo "Testing processor health endpoint..."
	curl -s http://localhost:8082/health | jq '.'

test-metrics:
	@echo "Getting producer metrics..."
	curl -s http://localhost:8081/metrics | jq '.'
	@echo ""
	@echo "Getting processor metrics..."
	curl -s http://localhost:8082/metrics | jq '.'

# Infrastructure dependencies
deps-up:
	@echo "Starting infrastructure dependencies..."
	docker-compose -f docker-compose.yaml up -d zookeeper kafka kafka-topics-init spark-master spark-worker

deps-down:
	@echo "Stopping infrastructure dependencies..."
	docker-compose -f docker-compose.yaml down

# Full pipeline management
full-up: deps-up up
	@echo "Full streaming pipeline started!"

full-down: down deps-down
	@echo "Full streaming pipeline stopped!"

# Monitoring
monitor:
	@echo "Starting monitoring stack..."
	docker-compose -f docker-compose.yaml up -d prometheus grafana kafka-ui

# Quick commands for common operations
quick-restart: down build up
	@echo "Quick restart completed!"

quick-logs: logs

quick-health: health

# Schema Registry management
schema-registry-status:
	@echo "Checking Schema Registry status..."
	@curl -s http://localhost:8085/subjects | jq '.' || echo "Schema Registry not responding"

list-schemas:
	@echo "Listing all registered schemas..."
	@curl -s http://localhost:8085/subjects | jq -r '.[]' | while read subject; do \
		echo "Subject: $$subject"; \
		curl -s "http://localhost:8085/subjects/$$subject/versions/latest" | jq '.version, .id'; \
		echo "---"; \
	done

register-schemas:
	@echo "Registering Avro schemas..."
	python scripts/init-schema-registry.py --schema-registry-url http://localhost:8085

verify-schemas:
	@echo "Verifying schema registration..."
	python scripts/init-schema-registry.py --schema-registry-url http://localhost:8085 --verify-only

# Schema Registry service management
schema-registry-up:
	@echo "Starting Schema Registry..."
	docker-compose -f docker-compose.yaml up -d schema-registry

schema-registry-down:
	@echo "Stopping Schema Registry..."
	docker-compose -f docker-compose.yaml stop schema-registry

schema-registry-logs:
	@echo "Showing Schema Registry logs..."
	docker-compose -f docker-compose.yaml logs -f schema-registry